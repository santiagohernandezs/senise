---
import { Section, SectionHeader, SectionContent } from "@layout";
import ChartBar from "@/components/ui/ChartBar.astro";

const metrics = [
  {
    title: "Liquidez",
    value: 19.8,
    color: "bg-chart-1",
  },
  {
    title: "Deuda Privada",
    value: 31.7,
    color: "bg-chart-2",
  },
  {
    title: "Private Equity",
    value: 48.5,
    color: "bg-chart-3",
  },
];
---

<Section id="metrics" variant="pattern" direction="row">
    <SectionHeader class="flex-1" tag="nuestras métricas" title="Resaltamos el rendimiento del capital">
      Maximizamos el rendimiento financiero reduciendo la fricción en tus operaciones.
    </SectionHeader>

  <SectionContent direction="column" class="flex-1 gap-10">
    {metrics.map((metric) => <ChartBar {...metric} />)}
  </SectionContent>
</Section>
