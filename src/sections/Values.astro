---
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionContent from "@/components/layout/SectionContent.astro";
import { Card, CardHeader, CardContent, CardTag, CardTitle, CardDescription } from "@card";
import Flower from "@/components/ui/svg/Flower.astro";

const cardsContent = [
  {
    tag: "Excelencia",
    title: "Cuidado en cada detalle",
    description:
      "Cuidar la selección, el análisis técnico y el seguimiento de cada oportunidad nos permite aportar solidez y consistencia al crecimiento patrimonial.",
    variant: "taupe" as const,
  },
  {
    tag: "Innovación",
    title: "Criterio ágil y dinámico",
    description:
      "El entorno económico evoluciona; nosotros nos adaptamos. Aplicamos estructuras flexibles para cada proyecto, buscando vías que impulsen un crecimiento orgánico y sostenible.",
    variant: "wine" as const,
  },
  {
    tag: "Cercanía",
    title: "Relaciones de socio a socio",
    description:
      "Como estructura patrimonial familiar, valoramos la transparencia y el trato directo. Te acompaño en las etapas clave del proyecto para construir relaciones de confianza duraderas.",
    variant: "green" as const,
  },
];
---

<Section id="values" direction="column">
  <SectionHeader tag="nuestros valores" title="Lo que nos define">
    <p>Principios clave que guían la asignación de nuestro patrimonio y nuestras alianzas estratégicas.</p>
  </SectionHeader>
  <SectionContent>
    {cardsContent.map(content => (
      <Card variant={content.variant} icon={Flower}>
        <CardContent>
          <CardHeader>
            <CardTag size="sm">
              {content.tag}
            </CardTag>
            <CardTitle class="text-lg">{content.title}</CardTitle>
          </CardHeader>
          <CardDescription>{content.description}</CardDescription>
        </CardContent>
      </Card>
    ))}
  </SectionContent>
</Section>
