---
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionContent from "@/components/layout/SectionContent.astro";
import { Card, CardHeader, CardContent, CardTag, CardTitle, CardDescription } from "@card";
import Flower from "@/components/ui/svg/Flower.astro";

const cardsContent = [
  {
    tag: "Excelencia",
    title: "Disciplina y rigor inversor",
    description:
      "La excelencia en la inversión comienza con un análisis riguroso, una adecuada evaluación de riesgos y un seguimiento continuo de cada operación.",
    variant: "taupe" as const,
  },
  {
    tag: "Innovación",
    title: "Agilidad y visión estratégica",
    description:
      "Nos adaptamos a la evolución del entorno económico mediante estructuras de inversión flexibles, identificando soluciones que favorezcan el desarrollo sostenible de cada proyecto.",
    variant: "wine" as const,
  },
  {
    tag: "Cercanía",
    title: "Relaciones de socio a socio",
    description:
      "Como estructura de inversión familiar, valoramos el trato directo, la transparencia y la cercanía con nuestros socios. Nos involucramos en cada proyecto con una visión compartida y el compromiso de construir relaciones de confianza duraderas.",
    variant: "green" as const,
  },
];
---

<Section id="values" direction="column">
  <SectionHeader tag="nuestros valores" title="Lo que nos define">
    <p>Principios que orientan nuestras decisiones de inversión y definen nuestra forma de construir relaciones estratégicas a largo plazo.</p>
  </SectionHeader>
  <SectionContent>
    {cardsContent.map(content => (
      <Card variant={content.variant} icon={Flower}>
        <CardContent>
          <CardHeader>
            <CardTag size="sm">
              {content.tag}
            </CardTag>
            <CardTitle class="text-lg">{content.title}</CardTitle>
          </CardHeader>
          <CardDescription>{content.description}</CardDescription>
        </CardContent>
      </Card>
    ))}
  </SectionContent>
</Section>
