---
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionContent from "@/components/layout/SectionContent.astro";
import Switch from "@/components/ui/Switch.astro";
import { Card, CardContent, CardTitle, CardDescription } from "@card";
import Flower from "@/components/ui/svg/Flower.astro";

const services = {
  deuda: {
    vertical: "Vertical A",
    title: "Deuda Privada Patrimonial",
    subtitle: "Soluciones de liquidez adaptadas a los tiempos de tu activo.",
    description:
      "Estructuramos operaciones de financiación alternativa respaldadas por colaterales tangibles, aportando certeza operativa para ejecutar proyectos y desarrollos sin comprometer los plazos del negocio. La adaptación a cada escenario es nuestra prioridad.",
    items: [
      {
        title: "Capital para Adquisición y Desarrollo",
        description:
          "Aportación de recursos para compra de suelo, obra nueva, rehabilitación o reposicionamiento.",
      },
      {
        title: "Soluciones de Liquidez Temporal",
        description:
          "Cobertura de necesidades operativas y puentes de liquidez en proyectos estructurados.",
      },
      {
        title: "Estructuras a Medida",
        description:
          "Flexibilidad operativa alineada con los flujos de caja proyectados del activo.",
      },
    ],
  },
  equity: {
    vertical: "Vertical B",
    title: "Coinversión y Capital (Equity)",
    subtitle: "Capital estratégico para desarrollos de alto impacto.",
    description:
      "No operamos como un mero financiador; nos involucramos como socios patrimoniales. Alineamos intereses aportando músculo financiero y estructuras totalmente flexibles:",
    items: [
      {
        title: "Joint Ventures",
        description:
          "Aportamos el capital de desarrollo manteniendo al promotor local al frente de la gestión operativa, bajo esquemas alineados.",
      },
      {
        title: "Capital Preferente",
        description:
          "Una alternativa para desarrolladores que buscan escalar proyectos manteniendo la gestión de su compañía.",
      },
      {
        title: "Estrategias Value-Add",
        description:
          "Inversión directa orientada al reposicionamiento y revalorización de activos inmobiliarios.",
      },
    ],
  },
};
---

<Section id="services" direction="column">
  <SectionHeader align="center" tag="estrategias de inversión" title="Crece conmigo, El método Senise">
    Priorizamos la solidez y el valor a largo plazo por encima de la
    especulación a corto plazo. Analizamos activos reales con capacidad de generación de flujo,
    estructurando nuestras inversiones mediante crédito privado patrimonial y participaciones de
    capital.
  </SectionHeader>

  <div class="mx-auto">
    <Switch />
  </div>

  <div id="services-deuda" class="w-full flex gap-10">
    <SectionContent class="flex-1" cols={3}>
      <div class="flex flex-col gap-2 max-w-3xl animate-card-in">
        <span class="text-xs uppercase tracking-widest font-bold text-brand-wine">
          {services.deuda.vertical}: {services.deuda.title}
        </span>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-primary">
          {services.deuda.subtitle}
        </h3>
        <p class="text-sm md:text-base text-text-secondary leading-relaxed">
          {services.deuda.description}
        </p>
      </div>

      {services.deuda.items.map((item, index) => (
      <div class:list={["animate-card-in md:cols-start-2", `stagger-${index + 1}`, "h-full flex flex-col", {"md:col-span-2 md:col-start-2": index===2}]}>
          <Card variant="cream" icon={Flower}>
            <CardContent>
              <CardTitle>{item.title}</CardTitle>
              <CardDescription>{item.description}</CardDescription>
            </CardContent>
          </Card>
        </div>
      ))}
    </SectionContent>
  </div>

  <div id="services-equity" class="w-full flex-col gap-10 hidden">
    <SectionContent class="flex-1" cols={3}>
      <div class="flex flex-col gap-2 max-w-3xl animate-card-in">
        <span class="text-xs uppercase tracking-widest font-bold text-brand-wine">
          {services.equity.vertical}: {services.equity.title}
        </span>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-primary">
          {services.equity.subtitle}
        </h3>
        <p class="text-sm md:text-base text-text-secondary leading-relaxed">
          {services.equity.description}
        </p>
      </div>

      {services.equity.items.map((item, index) => (
      <div class:list={["animate-card-in md:cols-start-2", `stagger-${index + 1}`, "h-full flex flex-col", {"md:col-span-2 md:col-start-2": index===2}]}>
          <Card variant="cream" icon={Flower}>
            <CardContent>
              <CardTitle>{item.title}</CardTitle>
              <CardDescription>{item.description}</CardDescription>
            </CardContent>
          </Card>
        </div>
      ))}
    </SectionContent>
  </div>
</Section>

<script>
  import { displayMode } from "@/store";

  const deudaContainer = document.getElementById("services-deuda");
  const equityContainer = document.getElementById("services-equity");

  displayMode.subscribe((currentMode) => {
    if (currentMode === "deuda") {
      deudaContainer?.classList.remove("hidden");
      equityContainer?.classList.add("hidden");
    } else {
      equityContainer?.classList.remove("hidden");
      deudaContainer?.classList.add("hidden");
    }
  });
</script>

<style>
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-card-in {
    animation: cardIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .stagger-1 {
    animation-delay: 0ms;
  }
  .stagger-2 {
    animation-delay: 45ms;
  }
  .stagger-3 {
    animation-delay: 90ms;
  }
</style>
