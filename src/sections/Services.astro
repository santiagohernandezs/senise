---
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionContent from "@/components/layout/SectionContent.astro";
import Switch from "@/components/ui/Switch.astro";
import { Card, CardContent, CardTitle, CardDescription } from "@card";
import Flower from "@/components/ui/svg/Flower.astro";

const services = {
  deuda: {
    title: "Deuda Privada",
    subtitle: "Financiación flexible respaldada por activos reales.",
    description:
      "Estructuramos operaciones de financiación privada adaptadas a las necesidades de cada proyecto, con especial atención a la calidad de los activos subyacentes, las garantías y la capacidad de generación de flujos de caja.",
    items: [
      {
        title: "Financiación para Adquisición y Desarrollo",
        description:
          "Financiación destinada a la adquisición de activos, desarrollo de nuevos proyectos, rehabilitación y reposicionamiento inmobiliario.",
        class: "bg-card-fill-rose",
      },
      {
        title: "Financiación Puente",
        description:
          "Soluciones de liquidez a corto y medio plazo, adaptadas a las necesidades de financiación y al calendario de ejecución de cada proyecto.",
        class: "bg-card-fill-taupe",
      },
      {
        title: "Estructuras de Financiación a Medida",
        description:
          "Diseñamos estructuras de financiación adaptadas a los flujos de caja previstos, las garantías disponibles y las características de cada operación.",
        class: "bg-card-fill-green",
      },
    ],
  },
  equity: {
    title: "Coinversión y Capital (Equity)",
    subtitle: "Participación estratégica en proyectos de inversión.",
    description:
      "Participamos como socios de capital en proyectos inmobiliarios y empresariales seleccionados, estableciendo estructuras de coinversión que favorecen la alineación de intereses y la creación de valor a largo plazo.",
    items: [
      {
        title: "Joint Ventures",
        description:
          "Participamos junto a promotores y socios estratégicos en proyectos de inversión, mediante estructuras de coinversión que favorecen la alineación de intereses y una distribución clara de responsabilidades.",
        class: "bg-card-fill-rose",
      },
      {
        title: "Capital Preferente",
        description:
          "Estructuramos participaciones de capital con derechos económicos preferentes, adaptadas a las necesidades de financiación y a la estructura de cada proyecto.",
        class: "bg-card-fill-taupe",
      },
      {
        title: "Estrategias Value-Add",
        description:
          "Invertimos en activos con potencial de reposicionamiento, mejora operativa o transformación, buscando generar valor mediante una gestión activa y una estrategia de inversión definida.",
        class: "bg-card-fill-green",
      },
    ],
  },
};
---

<Section id="services" direction="column">
  <SectionHeader align="center" tag="estrategias de inversión" title="Nuestro enfoque de inversión">
    Priorizamos la solidez financiera y la generación de valor a largo plazo. Analizamos oportunidades respaldadas por activos reales y capacidad de generación de flujos de caja, estructurando nuestras inversiones mediante financiación privada y participaciones de capital.
  </SectionHeader>

  <div class="mx-auto">
    <Switch />
  </div>

  <div id="services-deuda" class="w-full flex gap-10">
    <SectionContent class="flex-1" cols={3}>
      <div class="flex flex-col gap-2 max-w-3xl animate-card-in">
        <span class="text-sm uppercase tracking-wide font-bold text-brand-wine">
          {services.deuda.title}
        </span>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-primary">
          {services.deuda.subtitle}
        </h3>
        <p class="text-sm md:text-base text-text-secondary leading-relaxed">
          {services.deuda.description}
        </p>
      </div>

      {services.deuda.items.map((item, index) => (
      <div class:list={["animate-card-in md:cols-start-2", `stagger-${index + 1}`, "h-full flex flex-col", {"md:col-span-2 md:col-start-2": index===2}]}>
          <Card variant="cream" class={item.class} icon={Flower}>
            <CardContent>
              <CardTitle>{item.title}</CardTitle>
              <CardDescription>{item.description}</CardDescription>
            </CardContent>
          </Card>
        </div>
      ))}
    </SectionContent>
  </div>

  <div id="services-equity" class="w-full flex-col gap-10 hidden">
    <SectionContent class="flex-1" cols={3}>
      <div class="flex flex-col gap-2 max-w-3xl animate-card-in">
        <span class="text-sm uppercase tracking-wide font-bold text-brand-wine">
          {services.equity.title}
        </span>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-primary">
          {services.equity.subtitle}
        </h3>
        <p class="text-sm md:text-base text-text-secondary leading-relaxed">
          {services.equity.description}
        </p>
      </div>

      {services.equity.items.map((item, index) => (
      <div class:list={["animate-card-in md:cols-start-2", `stagger-${index + 1}`, "h-full flex flex-col", {"md:col-span-2 md:col-start-2": index===2}]}>
          <Card variant="cream" class={item.class} icon={Flower}>
            <CardContent>
              <CardTitle>{item.title}</CardTitle>
              <CardDescription>{item.description}</CardDescription>
            </CardContent>
          </Card>
        </div>
      ))}
    </SectionContent>
  </div>
</Section>

<script>
  import { displayMode } from "@/store";

  const deudaContainer = document.getElementById("services-deuda");
  const equityContainer = document.getElementById("services-equity");

  displayMode.subscribe((currentMode) => {
    if (currentMode === "deuda") {
      deudaContainer?.classList.remove("hidden");
      equityContainer?.classList.add("hidden");
    } else {
      equityContainer?.classList.remove("hidden");
      deudaContainer?.classList.add("hidden");
    }
  });
</script>

<style>
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-card-in {
    animation: cardIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .stagger-1 {
    animation-delay: 0ms;
  }
  .stagger-2 {
    animation-delay: 45ms;
  }
  .stagger-3 {
    animation-delay: 90ms;
  }
</style>
