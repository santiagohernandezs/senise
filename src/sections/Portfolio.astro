---
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionContent from "@/components/layout/SectionContent.astro";
import {
  Card,
  CardHeader,
  CardContent,
  CardMedia,
  CardTag,
  CardTitle,
} from "@card";
import { capitalize } from "@/utils/capitalize";

import CalleSagasta from "../assets/images/calle-sagasta-33.jpg";
import Costanilla from "../assets/images/costanilla-de-sampedro.jpg";
import Cortezo from "../assets/images/doctor-cortezo.jpg";
import Engracia from "../assets/images/santa-engracia.jpg";
import Terramar from "../assets/images/terramar-sitges.jpg";
import Socimi from "../assets/images/vbare-socimi.jpg";

const projects = [
  {
    id: "calle-sagasta",
    tag: "Impar Prime Alternative Investment II, SICC, S.A.",
    title: "Calle Sagasta 31-33",
    alt: "Rehabilitación y promoción residencial prime en Calle Sagasta 31-33, Chamberí, Madrid - Inversión Equity Senise Capital",
    image: CalleSagasta,
    type: "Equity",
    date: new Date("4/1/2023").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Madrid - España",
  },
  {
    id: "costanilla-de-sampedro",
    tag: "Costanilla Impar Living, S.L.",
    title: "Costanilla de Sampedro 10",
    alt: "Financiación de deuda privada para desarrollo residencial en Costanilla de Sampedro 10, Madrid - Senise Capital",
    image: Costanilla,
    type: "Deuda Privada",
    date: new Date("2/1/2025").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Madrid - España",
  },
  {
    id: "doctor-cortezo",
    tag: "Impar Prime Living Opportunity Fund I, FICC",
    title: "Doctor Cortezo 15",
    alt: "Inversión inmobiliaria de equity en Calle Doctor Cortezo 15, Centro de Madrid - Senise Capital",
    image: Cortezo,
    type: "Equity",
    date: new Date("8/1/2023").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Madrid - España",
  },
  {
    id: "santa-engracia",
    tag: "Impar Prime Alternative Investment Fund, FICC",
    title: "Santa Engracia 84",
    alt: "Activo residencial prime en Calle Santa Engracia 84, Chamberí, Madrid - Inversión Equity Senise Capital",
    image: Engracia,
    type: "Equity",
    date: new Date("1/1/2024").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Madrid - España",
  },
  {
    id: "terramar-sitges",
    tag: "Global Homes BCN 2022, S.L.",
    title: "Terramar Sitges",
    alt: "Financiación alternativa de proyecto residencial Terramar en Sitges, Barcelona - Senise Capital",
    image: Terramar,
    type: "Deuda Privada",
    date: new Date("7/1/2025").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Barcelona - España",
  },
  {
    id: "vbare-socimi",
    tag: "Singular Prime Investment SICC II, S.A.",
    title: "Vbare Socimi",
    alt: "Inversión corporativa y posicionamiento en cartera residencial Vbare Socimi - Senise Capital",
    image: Socimi,
    type: "Equity",
    date: new Date("11/1/2024").toLocaleDateString("es-ES", {
      month: "long",
      year: "numeric",
    }),
    location: "Madrid - España",
  },
];
---

<Section id="portfolio">
  <SectionHeader align="center" tag="nuestros proyectos y trayectoria" title="Nuestra trayectoria inversora.">
    <p class="text-sm sm:text-base text-text-primary leading-relaxed mb-3">
      Una selección de proyectos y operaciones que reflejan nuestra experiencia en inversión inmobiliaria, financiación privada y participaciones de capital, tanto de forma directa como a través de vehículos especializados.
    </p>
    <p class="text-xs sm:text-sm text-text-secondary leading-relaxed mb-2">
      <strong class="font-semibold text-text-primary">Información Corporativa:</strong> Senise Capital, S.L. es una sociedad patrimonial privada que invierte exclusivamente recursos propios. No presta servicios de inversión a terceros, no realiza captación de fondos del público ni está sujeta a registro como entidad gestora de instituciones de inversión colectiva.
    </p>
    <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
      <strong class="font-semibold text-text-primary">Historial inversor:</strong> Los proyectos y activos mostrados reflejan el historial de análisis, coinversión y asignación de capital realizados por la firma o sus directivos en el mercado inmobiliario desde 2013, en muchos casos a través de participaciones en vehículos o fondos de terceros operadores. Esta información se expone con fines estrictamente informativos y corporativos, sin que constituya en ningún caso una oferta de inversión, solicitud de fondos ni promoción de productos financieros.
    </p>
  </SectionHeader>

  <SectionContent>
    {projects.map(project => (
      <Card variant="ghost">
        <CardMedia alt={project.alt} image={project.image} />
        <CardContent>
          <CardHeader>
            <CardTag size="sm">{project.tag}</CardTag>
            <CardTitle>{project.title}</CardTitle>
          </CardHeader>
          <div>
            <p>Tipo de inversión: {project.type}</p>
            <p>{capitalize(project.date)}</p>
            <p>{project.location}</p>
          </div>
        </CardContent>
      </Card>
    ))
  }
  </SectionContent>
</Section>
