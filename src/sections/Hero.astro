---
import Button from "@/components/ui/Button.astro";
import { Section, SectionContent } from "@layout";

const heroVideoUrl = import.meta.env.PUBLIC_HERO_VIDEO_URL;
---

<Section id="hero">
  <SectionContent
    direction="column"
    cols={2}
  >
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-text-primary leading-[1.08]">
          Reconocemos el valor real y apostamos por él
      </h1>
      <div class="flex flex-col gap-4"> 
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl font-normal">
          Somos un vehículo ágil de capital privado e inversión inmobiliaria que inyecta recursos propios en proyectos de alto potencial, actuando como el socio estratégico que impulsa el crecimiento de la economía real.
        </p>
        <Button href="#contact" variant="primary" class="px-8 py-3.5 text-sm sm:text-base font-semibold shadow-sm hover:opacity-95 transition-all max-w-fit">
          Presentar Proyecto
        </Button>
      </div>
  </SectionContent>

  <video autoplay muted loop playsinline width="100%">
    <source src={heroVideoUrl} type="video/mp4"/>
  </video>

</Section>

