---
import Button from "@/components/ui/Button.astro";
import { Section, SectionContent } from "@layout";

const heroVideoUrl = import.meta.env.PUBLIC_HERO_VIDEO_URL;
---

<Section id="hero">
  <SectionContent
    direction="column"
    cols={12}
    gap="sm"
    class="items-start"
  >
    <h1 class="md:col-span-7 w-fit text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text-primary leading-[1.08] text-balance">
      Identificamos el valor real.<br class="hidden lg:inline" /> Y nos comprometemos con él.
    </h1>
    <div class="md:col-span-5 flex flex-col gap-4"> 
      <p class="text-base sm:text-lg text-text-secondary leading-relaxed font-normal">
        Somos la oficina patrimonial privada del grupo. Invertimos capital propio en proyectos inmobiliarios y empresariales de alto potencial, actuando como el socio estratégico que impulsa tu crecimiento. Construyamos el futuro juntos.
      </p>
      <Button href="#contact" variant="primary" class="px-8 py-3.5 text-sm sm:text-base font-semibold shadow-sm hover:opacity-95 transition-all max-w-fit">
        Presentar Proyecto
      </Button>
    </div>
  </SectionContent>

  <video autoplay muted loop playsinline width="100%">
    <source src={heroVideoUrl} type="video/mp4"/>
  </video>

</Section>

