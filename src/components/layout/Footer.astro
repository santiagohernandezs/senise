---
import { Image } from "astro:assets";
import logoImg from "@/assets/images/logo.png";
---

<footer class="w-full border-t border-border-subtle bg-brand-white">
  <div class="max-w-300 mx-auto px-4 xl:px-0 py-10 md:py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    
    <!-- Logo & Lema -->
    <div class="flex flex-col gap-2">
      <a href="/" class="flex items-center hover:opacity-90 transition-opacity select-none" aria-label="Senise Capital">
        <Image
          src={logoImg}
          alt="Senise Capital"
          class="h-7 md:h-8 w-auto object-contain"
          loading="lazy"
        />
      </a>
      <span class="text-[10px] md:text-[11px] tracking-widest uppercase font-semibold text-text-secondary select-none">
        SMART CAPITAL. PROYECTOS CON VALOR
      </span>
    </div>

    <!-- Legal & Cookies -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-text-secondary">
      <span class="select-none">© 2026 Senise Capital.</span>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <a
        href="/aviso-legal"
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Aviso Legal y Regulación
      </a>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <a
        href="/politica-de-privacidad"
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Política de Privacidad
      </a>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <button
        type="button"
        data-open-cookie-banner
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Preferencias de cookies
      </button>
    </div>

    <!-- Redes Sociales -->
    <div class="flex items-center gap-4 text-text-primary">
      <!-- Instagram -->
      <a
        href="https://www.instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Senise Capital"
        class="p-1.5 rounded-sm hover:text-brand-brown hover:bg-brand-brown/5 transition-all"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>
      </a>

      <!-- X (Twitter) -->
      <a
        href="https://x.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (Twitter) de Senise Capital"
        class="p-1.5 rounded-sm hover:text-brand-brown hover:bg-brand-brown/5 transition-all"
      >
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>

  </div>
</footer>
