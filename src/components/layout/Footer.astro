---
import { Image } from "astro:assets";
import logoImg from "@/assets/images/logo.png";
---

<footer class="w-full border-t border-border-subtle bg-brand-white">
  <div class="max-w-310 mx-auto px-4 xl:px-0 py-10 md:py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    
    <!-- Logo & Lema -->
    <div class="flex flex-col gap-2">
      <a href="/" class="flex items-center hover:opacity-90 transition-opacity select-none" aria-label="Senise Capital">
        <Image
          src={logoImg}
          alt="Senise Capital"
          class="h-7 md:h-8 w-auto object-contain"
          loading="lazy"
        />
      </a>
      <span class="text-[10px] md:text-[11px] tracking-widest uppercase font-semibold text-text-secondary select-none">
        SMART CAPITAL. PROYECTOS CON VALOR
      </span>
    </div>

    <!-- Legal & Cookies -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-text-secondary">
      <span class="select-none">© 2026 Senise Capital.</span>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <a
        href="/aviso-legal"
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Aviso Legal y Regulación
      </a>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <a
        href="/politica-de-privacidad"
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Política de Privacidad
      </a>
      <span class="text-border-subtle select-none" aria-hidden="true">•</span>
      <button
        type="button"
        data-open-cookie-banner
        class="hover:text-brand-brown underline cursor-pointer transition-colors"
      >
        Preferencias de cookies
      </button>
    </div>
  </div>
</footer>
