---
interface Props {
  variant?: "primary" | "ghost";
  class?: string;
  className?: string;
  icon?: (_props: any) => any;
}

const {
  variant = "primary",
  class: classProp,
  className: classNameProp,
  icon: Icon,
} = Astro.props;
const className = classProp || classNameProp || "";
---

<div
  class:list={[
    "flex flex-col gap-6 p-6 flex-1",
    {
      "bg-card-fill-primary border border-card-border-primary text-card-desc-primary [--card-title-color:var(--color-card-title-primary)] [--card-tag-color:var(--color-card-tag-primary)] [--card-desc-color:var(--color-card-desc-primary)] [--card-icon-color:var(--color-card-icon-primary)]":
        variant === "primary",
      "bg-card-fill-ghost border border-card-border-ghost text-card-desc-ghost [--card-title-color:var(--color-card-title-ghost)] [--card-tag-color:var(--color-card-tag-ghost)] [--card-desc-color:var(--color-card-desc-ghost)] [--card-icon-color:var(--color-card-icon-ghost)]":
        variant === "ghost",
    },
    className,
  ]}
>
  {Icon && (
    <div class="mb-10 text-[var(--card-icon-color)]">
      <Icon />
    </div>
  )}

  <slot />
</div>
