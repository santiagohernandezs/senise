---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className = "" } = Astro.props;
---

<div class:list={["w-full overflow-hidden rounded-sm", className]}>
  <Image alt={alt} src={image} class="w-full h-auto object-cover" />
</div>
