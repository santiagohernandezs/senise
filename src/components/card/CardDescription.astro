---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"p"> {
  class?: string;
}

const { class: className = "", ...attrs } = Astro.props;
---

<p
  class:list={[
    "text-sm leading-relaxed text-[var(--card-desc-color,inherit)]",
    className,
  ]}
  {...attrs}
>
  <slot />
</p>
