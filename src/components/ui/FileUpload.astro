---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label: string;
  helperText?: string;
  error?: string;
  accept?: string;
}

const {
  label,
  id: idProp,
  name,
  helperText = "Formatos admitidos: PDF, Word, Excel (máx. 50 MB)",
  error,
  accept = ".pdf,.doc,.docx,.xls,.xlsx,.zip",
  disabled = false,
  class: className = "",
  ...attr
} = Astro.props;

const inputId = idProp || (name ? `file-${name}` : "file-upload");
const inputName = name || idProp;
---

<div class:list={["flex flex-col gap-1.5 w-full", className]}>
  <label for={inputId} class="text-sm font-semibold text-text-primary select-none">
    {label}
  </label>

  <div
    id={`${inputId}-dropzone`}
    class="relative flex flex-col items-center justify-center p-5 border-2 border-dashed border-border-subtle rounded-sm bg-brand-white/40 hover:bg-brand-white/80 hover:border-brand-brown/70 transition-all duration-200 cursor-pointer group text-center"
  >
    <input
      type="file"
      id={inputId}
      name={inputName}
      accept={accept}
      disabled={disabled}
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer disabled:cursor-not-allowed"
      {...attr}
    />

    <!-- Estado inicial: Sin archivo -->
    <div id={`${inputId}-empty-state`} class="flex flex-col items-center gap-2 pointer-events-none">
      <div class="w-10 h-10 rounded-full bg-brand-brown/10 flex items-center justify-center text-brand-brown group-hover:scale-105 transition-transform duration-200">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
      </div>

      <div class="flex flex-col gap-0.5">
        <span class="text-sm font-medium text-text-primary group-hover:text-brand-brown transition-colors">
          Haz clic para subir o arrastra tu archivo aquí
        </span>
        <span class="text-xs text-text-secondary">
          {helperText}
        </span>
      </div>
    </div>

    <!-- Estado cuando hay archivo seleccionado -->
    <div id={`${inputId}-selected-state`} class="hidden items-center justify-between w-full px-2 py-1">
      <div class="flex items-center gap-3 overflow-hidden text-left">
        <div class="w-8 h-8 rounded bg-brand-brown/15 flex items-center justify-center text-brand-brown shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
        </div>
        <div class="flex flex-col min-w-0">
          <span id={`${inputId}-filename`} class="text-xs font-semibold text-text-primary truncate"></span>
          <span id={`${inputId}-filesize`} class="text-[11px] text-text-secondary"></span>
        </div>
      </div>

      <button
        type="button"
        id={`${inputId}-clear-btn`}
        class="ml-2 p-1 text-text-secondary hover:text-brand-rose transition-colors z-10 cursor-pointer"
        title="Quitar archivo"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  {error && (
    <p class="text-xs text-status-error font-medium">
      {error}
    </p>
  )}
</div>

<script define:vars={{ inputId }}>
  const input = document.getElementById(inputId);
  const emptyState = document.getElementById(`${inputId}-empty-state`);
  const selectedState = document.getElementById(`${inputId}-selected-state`);
  const filenameEl = document.getElementById(`${inputId}-filename`);
  const filesizeEl = document.getElementById(`${inputId}-filesize`);
  const clearBtn = document.getElementById(`${inputId}-clear-btn`);

  function formatBytes(bytes) {
    if (bytes === 0) return "0 Bytes";
    const k = 1024;
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i];
  }

  input?.addEventListener("change", () => {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      if (filenameEl) filenameEl.textContent = file.name;
      if (filesizeEl) filesizeEl.textContent = formatBytes(file.size);
      emptyState?.classList.add("hidden");
      selectedState?.classList.remove("hidden");
      selectedState?.classList.add("flex");
    }
  });

  clearBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (input) input.value = "";
    selectedState?.classList.add("hidden");
    selectedState?.classList.remove("flex");
    emptyState?.classList.remove("hidden");
  });
</script>
