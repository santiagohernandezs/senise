---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label?: string;
  description?: string;
  error?: string;
}

const {
  label,
  id: idProp,
  name,
  value = "on",
  description,
  error,
  disabled = false,
  class: className = "",
  ...attr
} = Astro.props;

// Genera un ID único y predecible
const inputId = idProp || (name ? `checkbox-${name}` : undefined);
---

<label
  for={inputId}
  class:list={[
    "inline-flex items-start gap-3 cursor-pointer select-none group p-3.5 rounded-sm border border-border-subtle bg-brand-white/40 hover:bg-brand-white/80 transition-all duration-200",
    { "opacity-50 cursor-not-allowed pointer-events-none": disabled },
    className,
  ]}
>
  <div class="relative flex items-center justify-center mt-0.5 shrink-0">
    <input
      type="checkbox"
      id={inputId}
      name={name}
      value={value}
      disabled={disabled}
      class="peer appearance-none w-4.5 h-4.5 rounded-xs border border-border-default bg-surface-canvas checked:border-border-accent checked:bg-surface-accent focus:outline-none focus:ring-2 focus:ring-ring-focus/20 transition-all cursor-pointer disabled:cursor-not-allowed"
      {...attr}
    />
    <!-- Icono de verificación blanco -->
    <svg
      class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-150"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </div>

  <div class="flex flex-col text-sm leading-relaxed text-text-primary">
    {label && (
      <span class="font-semibold text-text-primary leading-tight group-hover:text-brand-brown transition-colors">
        {label}
      </span>
    )}
    {description && (
      <p class="text-xs text-text-secondary mt-1 leading-normal">
        {description}
      </p>
    )}
    <slot />
    {error && (
      <span class="text-xs text-status-error font-medium mt-1">
        {error}
      </span>
    )}
  </div>
</label>
