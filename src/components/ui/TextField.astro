---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"input"> {
  label: string;
  error?: string;
  helperText?: string;
  inputClass?: string;
}

const {
  label,
  id: idProp,
  name,
  required = false,
  type = "text",
  error,
  helperText,
  class: className = "",
  inputClass = "",
  ...attr
} = Astro.props;

// Garantiza que label e input siempre estén asociados
const inputId = idProp || (name ? `field-${name}` : undefined);
const inputName = name || idProp;
---

<div class:list={["flex flex-col gap-1.5 w-full", className]}>
  <label for={inputId} class="text-sm font-semibold text-text-primary select-none">
    {label}
    {required && <span class="text-brand-rose ml-0.5">*</span>}
  </label>

  <input
    id={inputId}
    name={inputName}
    type={type}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error && inputId ? `${inputId}-error` : undefined}
    class:list={[
      "w-full px-3.5 py-2.5 rounded-sm text-sm text-text-primary transition-all duration-200",
      "bg-input-bg border placeholder:text-input-placeholder",
      "focus:outline-none focus:ring-1",
      error
        ? "border-status-error focus:border-status-error focus:ring-status-error/20"
        : "border-input-border hover:border-input-border-hover focus:border-input-border-focus focus:ring-ring-focus/20",
      "disabled:opacity-50 disabled:cursor-not-allowed",
      inputClass,
    ]}
    {...attr}
  />

  {error && (
    <p id={`${inputId}-error`} class="text-xs text-status-error font-medium">
      {error}
    </p>
  )}

  {helperText && !error && (
    <p class="text-xs text-text-secondary">
      {helperText}
    </p>
  )}
</div>
