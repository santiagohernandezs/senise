---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label: string;
  description?: string;
  error?: string;
}

const {
  label,
  id: idProp,
  name,
  value,
  description,
  error,
  disabled = false,
  class: className = "",
  ...attr
} = Astro.props;

// Genera un ID único y predecible para cada opción del grupo
const inputId = idProp || (name && value ? `radio-${name}-${value}` : undefined);
---

<label
  for={inputId}
  class:list={[
    "inline-flex items-start gap-3 cursor-pointer select-none group",
    { "opacity-50 cursor-not-allowed pointer-events-none": disabled },
    className,
  ]}
>
  <div class="relative flex items-center justify-center mt-0.5 shrink-0">
    <input
      type="radio"
      id={inputId}
      name={name}
      value={value}
      disabled={disabled}
      class="peer appearance-none w-4.5 h-4.5 rounded-full border border-border-default bg-surface-canvas checked:border-border-accent checked:bg-surface-accent focus:outline-none focus:ring-2 focus:ring-ring-focus/20 transition-all cursor-pointer disabled:cursor-not-allowed"
      {...attr}
    />
    <!-- Punto central blanco que aparece al estar seleccionado -->
    <span
      class="absolute w-1.5 h-1.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-150"
    ></span>
  </div>

  <div class="flex flex-col">
    <span class="text-sm font-medium text-text-primary leading-tight group-hover:text-brand-brown transition-colors">
      {label}
    </span>
    {description && (
      <span class="text-xs text-text-secondary mt-1">
        {description}
      </span>
    )}
    {error && (
      <span class="text-xs text-status-error font-medium mt-1">
        {error}
      </span>
    )}
  </div>
</label>
